{
    "name": "vd/vd-maintenance",
    "description": "Projektunabhängige TYPO3-Wartungs-Commands: Backup und Restore von Datenbank, fileadmin/ und frei konfigurierbaren Verzeichnissen",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Valeri Dutt",
            "email": "valeridutt@googlemail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.4",
        "typo3/cms-core": "^14.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/process": "^6.4 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0",
        "typo3/testing-framework": "^9.3"
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "autoload": {
        "psr-4": {
            "Vd\\VdMaintenance\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vd\\VdMaintenance\\Tests\\": "Tests/"
        }
    },
    "scripts": {
        "test:unit": "php vendor/bin/phpunit -c Build/phpunit/UnitTests.xml",
        "test:functional": "php vendor/bin/phpunit -c Build/phpunit/FunctionalTests.xml"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "vd_maintenance"
        }
    }
}
